<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                    xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
    <DataTemplate x:Key="PullRequest.SyntaxTokenTemplate">
        <TextBlock FontFamily="Consolas"
                   FontSize="13"
                   TextWrapping="NoWrap"
                   Text="{Binding Text}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Classification}" Value="Keyword">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static colors:EnvironmentColors.AccentMediumBrushKey}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Classification}" Value="String">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Classification}" Value="Number">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static colors:EnvironmentColors.AccentDarkBrushKey}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Classification}" Value="Comment">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static colors:EnvironmentColors.ClassDesignerCommentTextBrushKey}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Classification}" Value="Preprocessor">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemGrayTextBrushKey}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Classification}" Value="Type">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static colors:EnvironmentColors.ControlLinkTextBrushKey}}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="PullRequest.CommentCardTemplate">
        <Border Margin="10,8"
                Padding="12"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.AccentMediumBrushKey}}"
                Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                CornerRadius="4">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="24"
                            Height="24"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.AccentMediumBrushKey}}"
                            Background="{DynamicResource {x:Static colors:EnvironmentColors.AccentPaleBrushKey}}"
                            CornerRadius="12">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="{Binding AuthorInitials}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="7,0,12,0">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Author}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Opacity="0.65"
                                   Text="{Binding CreatedOn}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static colors:EnvironmentColors.AccentMediumBrushKey}}"
                                   Text="{Binding State}" />
                        <TextBlock Margin="0,2,0,0"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Opacity="0.7"
                                   Text="{Binding Location}" />
                    </StackPanel>
                </Grid>
                <TextBlock Margin="35,10,0,0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Text="{Binding Content}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="PullRequest.DiffRowTemplate">
        <Grid>
            <Border Padding="0,2"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RowType}" Value="Code">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ChangeType}" Value="Added">
                                <Setter Property="Background" Value="#2633A852" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ChangeType}" Value="Removed">
                                <Setter Property="Background" Value="#26D73A49" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Padding="8,2"
                               HorizontalAlignment="Right"
                               FontFamily="Consolas"
                               FontSize="12"
                               Opacity="0.58"
                               Text="{Binding BeforeLineText}" />
                    <TextBlock Grid.Column="1"
                               Padding="8,2"
                               HorizontalAlignment="Right"
                               FontFamily="Consolas"
                               FontSize="12"
                               Opacity="0.58"
                               Text="{Binding AfterLineText}" />
                    <TextBlock Grid.Column="2"
                               Padding="7,2,0,2"
                               FontFamily="Consolas"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="{Binding Marker}" />
                    <ItemsControl Grid.Column="3"
                                  Margin="5,2,20,2"
                                  ItemsSource="{Binding Tokens}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas"
                                           FontSize="13"
                                           TextWrapping="NoWrap"
                                           Text="{Binding Text}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Classification}" Value="Keyword">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource {x:Static colors:EnvironmentColors.AccentMediumBrushKey}}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Classification}" Value="String">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Classification}" Value="Number">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource {x:Static colors:EnvironmentColors.AccentDarkBrushKey}}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Classification}" Value="Comment">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource {x:Static colors:EnvironmentColors.ClassDesignerCommentTextBrushKey}}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Classification}" Value="Preprocessor">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemGrayTextBrushKey}}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Classification}" Value="Type">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource {x:Static colors:EnvironmentColors.ControlLinkTextBrushKey}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Padding="14,7"
                    Background="#1F4C8ED9"
                    BorderThickness="0,1,0,1"
                    BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RowType}" Value="Hunk">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontFamily="Consolas"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding Content}" />
            </Border>

            <Border Padding="14,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RowType}" Value="Meta">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontFamily="Consolas"
                           FontSize="12"
                           FontStyle="Italic"
                           Opacity="0.7"
                           Text="{Binding Content}" />
            </Border>

            <Border Margin="108,9,24,11"
                    Padding="14"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.AccentMediumBrushKey}}"
                    Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                    CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RowType}" Value="Comment">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="26"
                                Height="26"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.AccentMediumBrushKey}}"
                                Background="{DynamicResource {x:Static colors:EnvironmentColors.AccentPaleBrushKey}}"
                                CornerRadius="13">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="{Binding AuthorInitials}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="8,0,14,0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Author}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Opacity="0.65"
                                       Text="{Binding CreatedOn}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static colors:EnvironmentColors.AccentMediumBrushKey}}"
                                       Text="{Binding State}" />
                            <TextBlock Margin="0,2,0,0"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       Opacity="0.7"
                                       Text="{Binding Location}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="38,11,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Text="{Binding Content}" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PullRequest.SplitDiffRowTemplate">
        <Grid>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RowType}" Value="Code">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="0,2"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Left.ChangeType}" Value="Removed">
                                    <Setter Property="Background" Value="#32D73A49" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Padding="8,2"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.58"
                                   Text="{Binding Left.BeforeLineText}" />
                        <TextBlock Grid.Column="1"
                                   Padding="7,2,0,2"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding Left.Marker}" />
                        <ItemsControl Grid.Column="2"
                                      Margin="5,2,16,2"
                                      ItemTemplate="{StaticResource PullRequest.SyntaxTokenTemplate}"
                                      ItemsSource="{Binding Left.Tokens}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}" />

                <Border Grid.Column="2"
                        Padding="0,2"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Right.ChangeType}" Value="Added">
                                    <Setter Property="Background" Value="#3233A852" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Padding="8,2"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.58"
                                   Text="{Binding Right.AfterLineText}" />
                        <TextBlock Grid.Column="1"
                                   Padding="7,2,0,2"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding Right.Marker}" />
                        <ItemsControl Grid.Column="2"
                                      Margin="5,2,16,2"
                                      ItemTemplate="{StaticResource PullRequest.SyntaxTokenTemplate}"
                                      ItemsSource="{Binding Right.Tokens}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <Border Padding="14,7"
                    Background="#1F4C8ED9"
                    BorderThickness="0,1,0,1"
                    BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RowType}" Value="Hunk">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontFamily="Consolas"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding Content}" />
            </Border>

            <Border Padding="14,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RowType}" Value="Meta">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontFamily="Consolas"
                           FontSize="12"
                           FontStyle="Italic"
                           Opacity="0.7"
                           Text="{Binding Content}" />
            </Border>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RowType}" Value="Comment">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl Content="{Binding Comment}"
                                ContentTemplate="{StaticResource PullRequest.CommentCardTemplate}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CommentSide}" Value="Left">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <Border Grid.Column="1"
                        Background="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}" />

                <ContentControl Grid.Column="2"
                                Content="{Binding Comment}"
                                ContentTemplate="{StaticResource PullRequest.CommentCardTemplate}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CommentSide}" Value="Right">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
