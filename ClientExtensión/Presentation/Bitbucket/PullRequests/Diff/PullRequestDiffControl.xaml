<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml">
    <Grid Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="16,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="{Binding Title}" />
                    <TextBlock Margin="0,4,0,0"
                               FontFamily="Consolas"
                               FontSize="12"
                               Text="{Binding Path}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Margin="24,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.75"
                           Text="{Binding Comparison}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   Margin="16,8"
                   Style="{DynamicResource Layout.StatusText}"
                   Text="{Binding Status}" />

        <Border Grid.Row="2"
                Margin="12,0,12,12"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}"
                Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewMode}" Value="Unified">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ListBox Padding="0"
                     BorderThickness="0"
                     Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ItemTemplate="{DynamicResource PullRequest.DiffRowTemplate}"
                     ItemsSource="{Binding Rows}" />
        </Border>

        <Border Grid.Row="2"
                Margin="12,0,12,12"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}"
                Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewMode}" Value="Split">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Background="#164C8ED9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Padding="14,7"
                               FontWeight="SemiBold"
                               Text="Base" />
                    <Border Grid.Column="1"
                            Background="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}" />
                    <TextBlock Grid.Column="2"
                               Padding="14,7"
                               FontWeight="SemiBold"
                               Text="Pull Request" />
                </Grid>

                <ListBox Grid.Row="1"
                         Padding="0"
                         BorderThickness="0"
                         Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemTemplate="{DynamicResource PullRequest.SplitDiffRowTemplate}"
                         ItemsSource="{Binding SplitRows}" />
            </Grid>
        </Border>
    </Grid>
</DataTemplate>
