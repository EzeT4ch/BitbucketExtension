                                                                    <Button Margin="8,0,0,0"
                                                                            Content="Cancelar"
                                                                            Command="{Binding CancelCommentCommand}"
                                                                            IsEnabled="{Binding SendCommentCommand.RunningCommandsCount.IsZero}" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Padding="12,6"
