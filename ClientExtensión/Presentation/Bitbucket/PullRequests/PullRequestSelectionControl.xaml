                                                                               HorizontalAlignment="Right"
                                                                               FontSize="11"
                                                                               Opacity="0.7"
                                                                               Text="{Binding Thread}" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <ItemsControl Margin="35,10,0,0"
                                                                          ItemsSource="{Binding ContentBlocks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,6">
                                                                            <TextBlock FontSize="13"
                                                                                       TextWrapping="Wrap"
                                                                                       Text="{Binding Text}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Kind}" Value="Text">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>

                                                                            <StackPanel>
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Kind}" Value="Image">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                                <Border Padding="4"
                                                                                        BorderThickness="1"
                                                                                        BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
                                                                                    <Image MaxWidth="720"
                                                                                           MaxHeight="420"
                                                                                           HorizontalAlignment="Left"
                                                                                           Stretch="Uniform"
                                                                                           Source="{Binding ImageUrl}" />
                                                                                </Border>
                                                                                <TextBlock Margin="0,4,0,0"
                                                                                           FontSize="11"
                                                                                           Opacity="0.65"
                                                                                           TextWrapping="Wrap"
                                                                                           Text="{Binding AlternativeText}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Button Margin="35,10,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    Content="Responder"
                                                                    Command="{Binding OpenReplyCommand}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanReply}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>

                                                            <ContentControl Margin="35,8,0,0"
                                                                            Content="{Binding Actions}"
                                                                            ContentTemplate="{StaticResource CommentActionsTemplate}" />

                                                            <Border Margin="35,10,0,0"
                                                                    Padding="10"
                                                                    BorderThickness="1"
                                                                    BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}"
                                                                    CornerRadius="3">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsReplyEditorOpen}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <TextBlock FontWeight="SemiBold"
                                                                               Text="Respuesta Markdown" />
                                                                    <TextBox MinHeight="82"
                                                                             Margin="0,7,0,0"
                                                                             Padding="7"
                                                                             AcceptsReturn="True"
                                                                             TextWrapping="Wrap"
                                                                             VerticalScrollBarVisibility="Auto"
                                                                             Text="{Binding ReplyContent, Mode=TwoWay}" />
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Style="{DynamicResource Layout.StatusText}"
                                                                               TextWrapping="Wrap"
                                                                               Text="{Binding ReplyStatus}" />
                                                                    <WrapPanel Margin="0,8,0,0">
                                                                        <Button Content="Enviar"
                                                                                Command="{Binding SendReplyCommand}"
                                                                                CommandParameter="{Binding ReplyContent}"
                                                                                IsEnabled="{Binding SendReplyCommand.RunningCommandsCount.IsZero}" />
                                                                        <Button Margin="8,0,0,0"
                                                                                Content="Cancelar"
                                                                                Command="{Binding CancelReplyCommand}"
                                                                                IsEnabled="{Binding SendReplyCommand.RunningCommandsCount.IsZero}" />
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                            </Border>

                                                            <ItemsControl Margin="35,12,0,0"
                                                                          ItemsSource="{Binding Replies}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Padding="0,12,0,0"
                                                                                BorderThickness="0,1,0,0"
                                                                                BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
                                                                            <StackPanel>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="28" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <Border Width="24"
                                                                                            Height="24"
                                                                                            BorderThickness="1"
                                                                                            BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.AccentMediumBrushKey}}"
                                                                                            Background="{DynamicResource {x:Static colors:EnvironmentColors.AccentPaleBrushKey}}"
                                                                                            CornerRadius="12">
                                                                                        <TextBlock HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center"
                                                                                                   FontSize="10"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Text="{Binding AuthorInitials}" />
                                                                                    </Border>

                                                                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                                                                        <TextBlock FontWeight="SemiBold"
                                                                                                   Text="{Binding Author}" />
                                                                                        <TextBlock Margin="0,2,0,0"
                                                                                                   FontSize="11"
                                                                                                   Opacity="0.65"
                                                                                                   Text="{Binding CreatedOn}" />
                                                                                    </StackPanel>
                                                                                </Grid>

                                                                                <ItemsControl Margin="35,9,0,0"
                                                                                              ItemsSource="{Binding ContentBlocks}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Grid Margin="0,0,0,6">
                                                                                                <TextBlock FontSize="13"
                                                                                                           TextWrapping="Wrap"
                                                                                                           Text="{Binding Text}">
                                                                                                    <TextBlock.Style>
                                                                                                        <Style TargetType="TextBlock">
                                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                                            <Style.Triggers>
                                                                                                                <DataTrigger Binding="{Binding Kind}" Value="Text">
                                                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                                                </DataTrigger>
                                                                                                            </Style.Triggers>
                                                                                                        </Style>
                                                                                                    </TextBlock.Style>
                                                                                                </TextBlock>

                                                                                                <StackPanel>
                                                                                                    <StackPanel.Style>
                                                                                                        <Style TargetType="StackPanel">
                                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                                            <Style.Triggers>
                                                                                                                <DataTrigger Binding="{Binding Kind}" Value="Image">
                                                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                                                </DataTrigger>
                                                                                                            </Style.Triggers>
                                                                                                        </Style>
                                                                                                    </StackPanel.Style>
                                                                                                    <Border Padding="4"
                                                                                                            BorderThickness="1"
                                                                                                            BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
                                                                                                        <Image MaxWidth="680"
                                                                                                               MaxHeight="380"
                                                                                                               HorizontalAlignment="Left"
                                                                                                               Stretch="Uniform"
                                                                                                               Source="{Binding ImageUrl}" />
                                                                                                    </Border>
                                                                                                    <TextBlock Margin="0,4,0,0"
                                                                                                               FontSize="11"
                                                                                                               Opacity="0.65"
                                                                                                               TextWrapping="Wrap"
                                                                                                               Text="{Binding AlternativeText}" />
                                                                                                </StackPanel>
                                                                                            </Grid>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>

                                                                                <Button Margin="35,7,0,0"
                                                                                        HorizontalAlignment="Left"
                                                                                        Content="Responder"
                                                                                        Command="{Binding OpenReplyCommand}">
                                                                                    <Button.Style>
                                                                                        <Style TargetType="Button">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding CanReply}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                </Button>

                                                                                <ContentControl Margin="35,8,0,0"
                                                                                                Content="{Binding Actions}"
                                                                                                ContentTemplate="{StaticResource CommentActionsTemplate}" />

                                                                                <Border Margin="35,8,0,0"
                                                                                        Padding="10"
                                                                                        BorderThickness="1"
                                                                                        BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}"
                                                                                        CornerRadius="3">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsReplyEditorOpen}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <StackPanel>
                                                                                        <TextBlock FontWeight="SemiBold"
                                                                                                   Text="Respuesta Markdown" />
                                                                                        <TextBox MinHeight="82"
                                                                                                 Margin="0,7,0,0"
                                                                                                 Padding="7"
                                                                                                 AcceptsReturn="True"
                                                                                                 TextWrapping="Wrap"
                                                                                                 VerticalScrollBarVisibility="Auto"
                                                                                                 Text="{Binding ReplyContent, Mode=TwoWay}" />
                                                                                        <TextBlock Margin="0,6,0,0"
                                                                                                   Style="{DynamicResource Layout.StatusText}"
                                                                                                   TextWrapping="Wrap"
                                                                                                   Text="{Binding ReplyStatus}" />
                                                                                        <WrapPanel Margin="0,8,0,0">
                                                                                            <Button Content="Enviar"
                                                                                                    Command="{Binding SendReplyCommand}"
                                                                                                    CommandParameter="{Binding ReplyContent}"
                                                                                                    IsEnabled="{Binding SendReplyCommand.RunningCommandsCount.IsZero}" />
                                                                                            <Button Margin="8,0,0,0"
                                                                                                    Content="Cancelar"
                                                                                                    Command="{Binding CancelReplyCommand}"
                                                                                                    IsEnabled="{Binding SendReplyCommand.RunningCommandsCount.IsZero}" />
                                                                                        </WrapPanel>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>

                        <GridSplitter Grid.Column="3"
                                      Width="5"
                                      HorizontalAlignment="Stretch"
                                      Background="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}" />

                        <TabControl Grid.Column="4"
                                    Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                                    Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}">
                            <TabItem Header="Info">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="14">
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding PullRequestBrowser.Detail.Title}" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="{Binding PullRequestBrowser.Detail.Branches}" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Opacity="0.75"
                                                   Text="{Binding PullRequestBrowser.Detail.State}" />

                                        <TextBlock Margin="0,18,0,0"
                                                   FontWeight="SemiBold"
                                                   Text="Descripción" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="{Binding PullRequestBrowser.Detail.Description}" />

                                        <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Autor" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding PullRequestBrowser.Detail.Author}" />

                                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Fechas" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding PullRequestBrowser.Detail.CreatedOn}" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding PullRequestBrowser.Detail.UpdatedOn}" />

                                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Reviewers" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding PullRequestBrowser.Detail.Reviewers}" />

                                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Commits" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding PullRequestBrowser.Detail.Commits}" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding PullRequestBrowser.Detail.Options}" />

                                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Bitbucket" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding PullRequestBrowser.Detail.Url}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="{Binding PullRequestBrowser.Comments.TabTitle}">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Style="{DynamicResource Layout.StatusText}"
                                               TextWrapping="Wrap"
                                               Text="{Binding PullRequestBrowser.Comments.Status}" />

                                    <Border Grid.Row="1"
                                            Margin="0,10,0,0"
                                            Padding="10"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}"
                                            CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="Nuevo comentario (Markdown)" />
                                            <TextBox MinHeight="64"
                                                     Margin="0,7,0,0"
                                                     Padding="7"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding PullRequestBrowser.Comments.NewCommentContent, Mode=TwoWay}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Style="{DynamicResource Layout.StatusText}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding PullRequestBrowser.Comments.NewCommentStatus}" />
                                            <Button Margin="0,8,0,0"
                                                    HorizontalAlignment="Left"
                                                    Content="Comentar"
                                                    Command="{Binding PullRequestBrowser.Comments.CreateCommentCommand}"
                                                    CommandParameter="{Binding PullRequestBrowser.Comments.NewCommentContent}" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Row="2"
                                               Margin="0,12,0,6"
                                               FontWeight="SemiBold"
                                               Text="Sin resolver" />

                                    <ListBox Grid.Row="3"
                                             Padding="0"
                                             Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ItemsSource="{Binding PullRequestBrowser.Comments.Unresolved}"
                                             ItemTemplate="{StaticResource PullRequestCommentTemplate}">
                                    </ListBox>

                                    <Expander Grid.Row="4"
                                              Margin="0,10,0,0"
                                              Header="{Binding PullRequestBrowser.Comments.AllHeader}"
                                              IsExpanded="False">
                                        <ListBox MaxHeight="320"
                                                 Padding="0"
                                                 Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ItemsSource="{Binding PullRequestBrowser.Comments.All}"
                                                 ItemTemplate="{StaticResource PullRequestCommentTemplate}">
                                        </ListBox>
                                    </Expander>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Tareas">
                                <TextBlock Margin="16"
                                           Style="{DynamicResource Layout.BodyText}"
                                           Text="{Binding PullRequestBrowser.Detail.TaskSummary}" />
                            </TabItem>

                            <TabItem Header="Actividad">
                                <TextBlock Margin="16"
                                           Style="{DynamicResource Layout.BodyText}"
                                           Text="{Binding PullRequestBrowser.Detail.ActivitySummary}" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</DataTemplate>
