<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml">
    <DataTemplate.Resources>
        <DataTemplate x:Key="CommentActionsTemplate">
            <StackPanel>
                <WrapPanel>
                    <Button Margin="0,0,8,0"
                            Content="Editar"
                            Command="{Binding EditCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanEdit}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="0,0,8,0"
                            Content="Eliminar"
                            Command="{Binding DeleteCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="0,0,8,0"
                            Content="Resolver"
                            Command="{Binding ResolveCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanResolve}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="0,0,8,0"
                            Content="Reabrir"
                            Command="{Binding ReopenCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanReopen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>

                <Border Margin="0,8,0,0"
                        Padding="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}"
                        CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDeleteConfirmationVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="¿Eliminar este comentario? Esta acción no se puede deshacer." />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Confirmar eliminación"
                                    Command="{Binding ConfirmDeleteCommand}" />
                            <Button Margin="8,0,0,0"
                                    Content="Cancelar"
                                    Command="{Binding CancelDeleteCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,8,0,0"
                        Padding="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}"
                        CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="Editar comentario (Markdown)" />
                        <TextBox MinHeight="82"
                                 Margin="0,7,0,0"
                                 Padding="7"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding EditContent, Mode=TwoWay}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Guardar"
                                    Command="{Binding SaveEditCommand}"
                                    CommandParameter="{Binding EditContent}" />
                            <Button Margin="8,0,0,0"
                                    Content="Cancelar"
                                    Command="{Binding CancelEditCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,6,0,0"
                           Style="{DynamicResource Layout.StatusText}"
                           TextWrapping="Wrap"
                           Text="{Binding Status}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PullRequestCommentTemplate">
            <Border Margin="0,0,0,10"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}"
                    Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Opacity="0.82"
                               TextWrapping="Wrap"
                               Text="{Binding Location}" />

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="24"
                                Height="24"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}"
                                Background="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}"
                                CornerRadius="12">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="{Binding AuthorInitials}" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="7,0,0,0">
                            <TextBlock FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding Author}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Opacity="0.65"
                                       Text="{Binding CreatedOn}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="35,10,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Text="{Binding Content}" />

                    <WrapPanel Margin="35,10,0,0">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding State}" />
                        <TextBlock Margin="12,0,0,0"
                                   Opacity="0.65"
                                   Text="{Binding Thread}" />
                    </WrapPanel>

                    <Button Margin="35,10,0,0"
                            HorizontalAlignment="Left"
                            Content="Responder"
                            Command="{Binding OpenReplyCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanReply}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <ContentControl Margin="35,8,0,0"
                                    Content="{Binding Actions}"
                                    ContentTemplate="{StaticResource CommentActionsTemplate}" />

                    <Border Margin="35,10,0,0"
                            Padding="10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}"
                            CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReplyEditorOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="Respuesta Markdown" />
                            <TextBox MinHeight="82"
                                     Margin="0,7,0,0"
                                     Padding="7"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding ReplyContent, Mode=TwoWay}" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{DynamicResource Layout.StatusText}"
                                       TextWrapping="Wrap"
                                       Text="{Binding ReplyStatus}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Enviar"
                                        Command="{Binding SendReplyCommand}"
                                        CommandParameter="{Binding ReplyContent}"
                                        IsEnabled="{Binding SendReplyCommand.RunningCommandsCount.IsZero}" />
                                <Button Margin="8,0,0,0"
                                        Content="Cancelar"
                                        Command="{Binding CancelReplyCommand}"
                                        IsEnabled="{Binding SendReplyCommand.RunningCommandsCount.IsZero}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </DataTemplate.Resources>

    <Grid Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="14,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
            <StackPanel>
                <TextBlock Style="{DynamicResource Layout.PageTitle}"
                           Text="{Binding Title}" />
                <TextBlock Style="{DynamicResource Layout.PageSubtitle}"
                           Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="12,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Margin="0,0,0,4"
                                   Text="Workspace" />
                        <ComboBox MinWidth="190"
                                  ItemsSource="{Binding Workspaces}"
                                  DisplayMemberPath="Slug"
                                  SelectedValuePath="Slug"
                                  SelectedValue="{Binding SelectedWorkspaceSlug, Mode=TwoWay}"
                                  IsEnabled="{Binding IsWorkspaceSelectorEnabled}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Margin="0,0,0,4"
                                   Text="Repositorio" />
                        <ComboBox MinWidth="240"
                                  ItemsSource="{Binding Repositories}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Slug"
                                  SelectedValue="{Binding SelectedRepositorySlug, Mode=TwoWay}"
                                  IsEnabled="{Binding IsRepositorySelectorEnabled}" />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Margin="0,0,18,0"
                               Style="{DynamicResource Layout.StatusText}"
                               Text="{Binding WorkspaceStatus}" />
                    <TextBlock Style="{DynamicResource Layout.StatusText}"
                               Text="{Binding RepositoryStatus}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2"
                    Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                    Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                    SelectedIndex="{Binding PullRequestBrowser.SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="{Binding PullRequestBrowser.ListTabTitle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="12,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
                        <TextBlock Style="{DynamicResource Layout.StatusText}"
                                   Text="{Binding PullRequestBrowser.ListStatus}" />
                    </Border>

                    <ListBox Grid.Row="1"
                             Padding="0"
                             Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                             BorderThickness="0"
                             Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemsSource="{Binding PullRequestBrowser.PullRequests}"
                             SelectedValuePath="Id"
                             SelectedValue="{Binding PullRequestBrowser.SelectedPullRequestId, Mode=TwoWay}"
                             IsEnabled="{Binding PullRequestBrowser.IsPullRequestSelectorEnabled}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,9"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DisplayTitle}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="16,0,0,0"
                                                   Opacity="0.8"
                                                   Text="{Binding State}" />

                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   Opacity="0.72"
                                                   Text="{Binding Metadata}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Margin="16,4,0,0"
                                                   Opacity="0.72"
                                                   Text="{Binding Activity}" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.ColumnSpan="2"
                                                   Margin="0,5,0,0"
                                                   Text="{Binding BranchRoute}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding PullRequestBrowser.DetailTabTitle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="12,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
                        <TextBlock Style="{DynamicResource Layout.StatusText}"
                                   Text="{Binding PullRequestBrowser.Detail.Status}" />
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" MinWidth="280" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="2*" MinWidth="320" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="1.45*" MinWidth="320" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Margin="12,10,12,0"
                                       Style="{DynamicResource Layout.SectionTitle}"
                                       Text="Archivos modificados" />
                            <TextBlock Grid.Row="1"
                                       Margin="12,6,12,10"
                                       Style="{DynamicResource Layout.StatusText}"
                                       Text="{Binding PullRequestBrowser.Files.Status}" />

                            <TreeView Grid.Row="2"
                                      Padding="8,0,8,8"
                                      Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                                      BorderThickness="0"
                                      Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ItemsSource="{Binding PullRequestBrowser.Files.Tree}"
                                      IsEnabled="{Binding PullRequestBrowser.Files.IsSelectorEnabled}">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>

                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid Margin="2,3,4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding Glyph}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Name}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Opacity="0.65"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Details}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding LineSummary}" />
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>

                        <GridSplitter Grid.Column="1"
                                      Width="5"
                                      HorizontalAlignment="Stretch"
                                      Background="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}" />

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="12,8,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding PullRequestBrowser.Files.SelectedFileTitle}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{DynamicResource Layout.HelperText}"
                                               Text="Vista previa del diff unificado" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="12,5"
                                        VerticalAlignment="Center"
                                        Content="Abrir diff en Visual Studio"
                                        Command="{Binding PullRequestBrowser.Files.OpenDiffDocumentCommand}"
                                        CommandParameter="{Binding PullRequestBrowser.Files.SelectedPath}"
                                        IsEnabled="{Binding PullRequestBrowser.Files.CanOpenDiffDocument}" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Margin="12,6,12,10"
                                       Style="{DynamicResource Layout.StatusText}"
                                       Text="{Binding PullRequestBrowser.Files.DiffStatus}" />
                            <Border Grid.Row="2"
                                    Margin="12,0,12,12"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}"
                                    Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}">
                                <ListBox Padding="0"
                                         BorderThickness="0"
                                         Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ItemsSource="{Binding PullRequestBrowser.Files.DiffRows}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Border Padding="0,2"
                                                            BorderThickness="0,0,0,1"
                                                            BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ControlOutlineKey}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RowType}" Value="Code">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ChangeType}" Value="Added">
                                                                        <Setter Property="Background" Value="#2633A852" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ChangeType}" Value="Removed">
                                                                        <Setter Property="Background" Value="#26D73A49" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="24" />
                                                                    <ColumnDefinition Width="52" />
                                                                    <ColumnDefinition Width="52" />
                                                                    <ColumnDefinition Width="24" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Button Width="20"
                                                                        Height="18"
                                                                        Padding="0"
                                                                        Content="+"
                                                                        FontWeight="SemiBold"
                                                                        ToolTip="Comentar esta línea"
                                                                        Command="{Binding OpenCommentCommand}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding CanAddComment}" Value="True" />
                                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </MultiDataTrigger>
                                                                                <DataTrigger Binding="{Binding IsCommentEditorOpen}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <TextBlock Grid.Column="1"
                                                                           Padding="8,1"
                                                                           HorizontalAlignment="Right"
                                                                           FontFamily="Consolas"
                                                                           FontSize="11"
                                                                           Opacity="0.55"
                                                                           Text="{Binding BeforeLineText}" />
                                                                <TextBlock Grid.Column="2"
                                                                           Padding="8,1"
                                                                           HorizontalAlignment="Right"
                                                                           FontFamily="Consolas"
                                                                           FontSize="11"
                                                                           Opacity="0.55"
                                                                           Text="{Binding AfterLineText}" />
                                                                <TextBlock Grid.Column="3"
                                                                           Padding="6,1,0,1"
                                                                           FontFamily="Consolas"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding Marker}" />
                                                                <ItemsControl Grid.Column="4"
                                                                              Margin="4,1,16,1"
                                                                              ItemsSource="{Binding Tokens}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock FontFamily="Consolas"
                                                                                       FontSize="12"
                                                                                       TextWrapping="NoWrap"
                                                                                       Text="{Binding Text}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground"
                                                                                                Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Classification}" Value="Keyword">
                                                                                                <Setter Property="Foreground"
                                                                                                        Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Classification}" Value="String">
                                                                                                <Setter Property="Foreground"
                                                                                                        Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Classification}" Value="Number">
                                                                                                <Setter Property="Foreground"
                                                                                                        Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Classification}" Value="Comment">
                                                                                                <Setter Property="Foreground"
                                                                                                        Value="{DynamicResource {x:Static colors:EnvironmentColors.ClassDesignerCommentTextBrushKey}}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Classification}" Value="Preprocessor">
                                                                                                <Setter Property="Foreground"
                                                                                                        Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemGrayTextBrushKey}}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Classification}" Value="Type">
                                                                                                <Setter Property="Foreground"
                                                                                                        Value="{DynamicResource {x:Static colors:EnvironmentColors.ControlLinkTextBrushKey}}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        <Border Width="560"
                                                                Margin="152,6,16,8"
                                                                Padding="10"
                                                                HorizontalAlignment="Left"
                                                                BorderThickness="1"
                                                                BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.AccentMediumBrushKey}}"
                                                                Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                                                                CornerRadius="3">
                                                            <Border.Style>
