<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>ClientExtension</AssemblyName>
        <RootNamespace>ClientExtension</RootNamespace>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <DeployExtension Condition="'$(Configuration)' == 'Debug' and '$(BuildingInsideVisualStudio)' == 'true'">true</DeployExtension>
        <UserSecretsId>7b6b6a5e-9a2f-4d3a-9a4e-3c9e2f6a4b1a</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
      <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\RequestAdapter\RequestAdapter.csproj" />
      <ProjectReference Include="..\BitbucketAdapter\BitbucketAdapter.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Presentation\Bitbucket\PullRequests\PullRequestSelectionControl.xaml" />
      <EmbeddedResource Include="Presentation\Shared\Layout\RemoteUiLayout.xaml" />
    </ItemGroup>

</Project>
